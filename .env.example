# Server-only configuration. Never commit a populated .env file.
APP_ENV=development
PORT=3000
API_SECRET_KEY=replace-with-a-random-32-character-secret
DATABASE_URL=postgresql://localhost:5432/profile2resume
MONGODB_URI=mongodb://127.0.0.1:27017/profile2resume
MONGODB_DB_NAME=profile2resume
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_SENSITIVE_MAX_REQUESTS=20
REQUEST_TIMEOUT_MS=30000

# Public browser configuration must use a separate, explicitly public prefix.
# PUBLIC_API_BASE_URL=http://localhost:3000/api
